# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# URL pública de la app (la de Vercel). Mercado Pago la usa para avisar los pagos y volver al panel.
NEXT_PUBLIC_APP_URL=https://tu-app.vercel.app

# --- Cobros con Mercado Pago (opcional; sin esto el botón de cobro no aparece o avisa que falta configurar) ---
# Credenciales de prueba para desarrollar (empiezan con TEST-) y de producción para cobrar de verdad.
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx
# Clave secreta del webhook (Tus integraciones > Webhooks). Si la cargás, se valida la firma de cada aviso.
MP_WEBHOOK_SECRET=
# Solo servidor. El webhook la usa para actualizar los pagos. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
